# This file is the template for `.env`, which is the **deployment's**
# configuration: the values a colleague needs to run the same thing you do.
#
# For values true on one machine only — your own service URLs, a dev secret —
# use `.env.local` beside it. It is read after `.env` and overrides it, and it
# is gitignored, so nothing in it travels. Real environment variables win over
# both, which is what keeps a container's `-e` in charge.
#
# A setting a deployment needs belongs here and in `.env`, never only in
# `.env.local`, or the next person cannot find it.

# Required
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:15432/rec_onboarding
OPENAI_API_KEY=sk-...

# Encryption — required by default (REQUIRE_ENCRYPTION=false to skip in dev)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# GDPR — Data Processing Agreement
# Sign the DPA with your LLM provider (e.g. https://privacy.openai.com),
# keep a copy on file, then set this to allow app startup:
# DPA_SIGNED=yes

# Admin console authentication
#
# ADMIN_TOKEN is GONE. Operators authenticate with their Keycloak identity and
# are authorised by their organization + group (admins/managers/editors/viewers);
# startup refuses to run if the variable is still set, because a leftover value
# reads as protection that is not there. For a deployment with no Keycloak, the
# break-glass is `onboarding-cli --local`.
#
# The issuer below is shared with the outbound M2M config further down — user and
# service tokens come from the same realm.
# OIDC_BASE_URL=http://keycloak.celine.localhost/realms/celine
# OIDC_JWKS_URI=                       # defaults to {OIDC_BASE_URL}/protocol/openid-connect/certs
# OIDC_AUDIENCE=svc-onboarding         # `aud` a caller's token must carry
# OIDC_CLIENT_ID=svc-onboarding
# JWT_HEADER_NAME=x-auth-request-access-token   # set by oauth2-proxy
#
# OPA policies for /api/admin, evaluated in-process.
# POLICIES_DIR=./policies
# ALLOW_PERMISSIVE_POLICY=false        # true ALLOWS EVERYTHING when policies fail to load
#
# `onboarding-cli admin ...` drives the same endpoints the console does, with a
# service account, so the CLI goes through the same policies and writes the same
# audit rows.
# ONBOARDING_API_URL=http://localhost:8040
# ONBOARDING_CLI_CLIENT_ID=svc-onboarding-cli
# ONBOARDING_CLI_CLIENT_SECRET=
# ALLOW_LOCAL_ADMIN=false              # --local bypasses authorization; break-glass only
#
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# SECURITY_HEADERS=true
# DOWNLOAD_TOKEN_TTL=86400

# Optional overrides
# EXTRACTION_BASE_URL=https://api.openai.com/v1
# EXTRACTION_MODEL=gpt-5.4
# DATA_DIR=./data
# TEMPLATES_DIR=./templates
# MAX_UPLOAD_SIZE_MB=10

# SMTP (email notifications on submission)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_TLS=true
# SMTP_NOTIFY=operator@example.com

# SMS phone verification (OTP)
# SMS_PROVIDER=log                # log (dev, prints OTP to stdout) | brevo
# BREVO_API_KEY=                  # required when SMS_PROVIDER=brevo
# BREVO_SMS_SENDER=CELINE         # alphanumeric sender id (max 11 chars) or E.164 number
# SMS_OTP_TEMPLATE=Il tuo codice di verifica e' {code}
# DPA_SMS_SIGNED=no               # must be yes for any non-log provider (GDPR Art. 28)
# OTP_CODE_LENGTH=6
# OTP_TTL_SECONDS=600             # code validity (10 min)
# OTP_MAX_ATTEMPTS=3              # wrong guesses before lockout
# OTP_MAX_SENDS_PER_HOUR=3        # per phone number
# OTP_LOCKOUT_SECONDS=3600        # lockout duration after attempts exhausted

# REC registry — where an approved participant is registered as a community
# member. Empty disables registration. Which community they join, and their
# area, live in the template manifest's `rec_registry:` block:
#
#   rec_registry:
#     community: example-community     # community key in the registry
#     default_area: north              # when no area covers the municipality
#     areas:                           # optional, coarse stand-in for geofences
#       valley-north: [Springfield, Shelbyville]
#
# REC_REGISTRY_URL=http://host.docker.internal:8004

# Dataspace DID/VC provisioning on admin approval (HTTP integration with identity-registry)
# DATASPACE_ENABLED=false
# IDENTITY_REGISTRY_URL=http://host.docker.internal:30005   # required when DATASPACE_ENABLED=true
# OIDC_BASE_URL=http://keycloak.celine.localhost/realms/celine   # M2M token issuer
#
# One realm for every service-to-service call this app makes — identity
# registry, connector, provenance and REC registry alike. Realm alignment
# converges on `celine`; do not point this at the dataspaces realm.
# DS_ONBOARDING_CLIENT_ID=svc-ds-onboarding
# DS_ONBOARDING_CLIENT_SECRET=   # required when DATASPACE_ENABLED=true
# DATASPACE_USER_ROLE=DataSubject
# DATASPACE_ALLOWED_ACTIONS=consent.manage,data.share
# DATASPACE_VC_TTL_DAYS=365
# DATASPACE_SUBJECT_SOURCE=email_hash  # deterministic from login email, without exposing email in DID paths

# Connector, for the member's own consent surface and for provisioning standing
# consent after approval.
# DS_CONNECTOR_URL=http://host.docker.internal:8100
# DS_NS_URL=                     # empty falls back to the connector's /ns path
#
# Provenance, for `GET /api/me/data-sharing/history` and NOTHING else. This is a
# member's Art. 15 read of events already recorded, under their own credential.
# Disclosures are written through the connector's POST /admin/disclosure, which
# computes the consent-snapshot hash a disclosure record requires — that has not
# changed and must not drift back here. Empty returns an empty history rather
# than failing: the decisions stand without it.
# DS_PROVENANCE_URL=http://host.docker.internal:8200

# ─────────────────────────────────────────────────────────────────────────────
# The per-community dataspace binding is NOT here — it lives in each template's
# manifest, under a `dataspace:` block:
#
#   dataspace:
#     organization: example-community          # = KC org alias = IR owner id
#     organization_did: did:web:example-community.dataspaces.localhost
#     linked_participant_did: did:web:consumer.dataspaces.localhost
#     membership_role: member
#
# It is per community because this platform is multi-tenant: a deployment serves
# several RECs and each belongs to its own dataspace organization. As deployment
# settings these filed every approved member into one organization — silently,
# since the wrong membership is still a successful 201.
#
# The organization must already exist and be promoted in the identity registry.
# Onboarding never creates one, and refuses to start when a bound community's
# organization is missing.
#
# There is deliberately no deployment-wide equivalent of these keys.
# ─────────────────────────────────────────────────────────────────────────────

# Keycloak user provisioning on admin approval
#
# There is no administrator credential here, and there must not be one. The
# Admin API is called as OIDC_CLIENT_ID / OIDC_CLIENT_SECRET — celine's own
# client, because provisioning a login is celine's business and not the
# dataspace's — and its rights are scoped to ONE GROUP of the realm, the one
# DATASPACE_KEYCLOAK_PARTICIPANTS_GROUP names:
#
#     manage-members      create the participant, update their profile,
#     manage-membership   reset their password, disable them — all of it
#     view-members        inside that group and nowhere else
#     view                resolve the group itself, which is how a participant
#                         who already has a login is found again
#
# It is not granted by hand: celine-policies declares it in clients.yaml under
# `admin_permissions` and `keycloak sync` creates both the group and the grant.
# A realm that has not been synced has neither, and provisioning fails.
#
# What this buys is what the service CANNOT do. It cannot read the realm's user
# list, disable an operator's account, or reset anybody's password outside the
# group — all 403, including creating a user in no group at all.
#
# The group must not be one of the operator role-hierarchy groups (admins,
# managers, editors, viewers): this console reads a realm-level one as a grant
# over every community on the deployment, so provisioning into it would make
# every participant an operator everywhere. Startup refuses those four names.
#
# BASE_URL and REALM are both normally left unset, and both default to what
# OIDC_BASE_URL says, because a token minted there works nowhere else:
#
#   the realm — a client-credentials token administers the realm that minted it
#               and no other, so provisioning happens in the issuer's realm
#   the host  — Keycloak compares a token's issuer against the address the
#               request arrived on and answers 401 when they differ, before it
#               looks at any role
#
# Set either only where that is not true of your Keycloak.
#
# DATASPACE_KEYCLOAK_ADMIN_USERNAME, _PASSWORD and _CLIENT_SECRET were the old
# password-grant login as a realm administrator. Startup now refuses to run with
# any of them set: remove them, and rotate what they held. See
# docs/decisions/ADR-0002-administer-the-realm-as-celines-own-client.md.
# DATASPACE_KEYCLOAK_ENABLED=false
# DATASPACE_KEYCLOAK_BASE_URL=
# DATASPACE_KEYCLOAK_REALM=
# DATASPACE_KEYCLOAK_PARTICIPANTS_GROUP=/participants
# DATASPACE_KEYCLOAK_DEFAULT_PASSWORD=test
# DATASPACE_KEYCLOAK_TEMPORARY_PASSWORD=false
# DATASPACE_KEYCLOAK_UPDATE_EXISTING=true
