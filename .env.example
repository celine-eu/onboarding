# Required
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:15432/rec_onboarding
OPENAI_API_KEY=sk-...

# Encryption — required by default (REQUIRE_ENCRYPTION=false to skip in dev)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# GDPR — Data Processing Agreement
# Sign the DPA with your LLM provider (e.g. https://privacy.openai.com),
# keep a copy on file, then set this to allow app startup:
# DPA_SIGNED=yes

# Admin & security
# ADMIN_TOKEN=change-me-to-a-long-random-string
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# SECURITY_HEADERS=true
# DOWNLOAD_TOKEN_TTL=86400

# Optional overrides
# EXTRACTION_BASE_URL=https://api.openai.com/v1
# EXTRACTION_MODEL=gpt-5.4
# DATA_DIR=./data
# TEMPLATES_DIR=./templates
# TEMPLATE_DIR=  # deprecated: single-REC mode, overrides TEMPLATES_DIR
# MAX_UPLOAD_SIZE_MB=10

# SMTP (email notifications on submission)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_TLS=true
# SMTP_NOTIFY=operator@example.com

# SMS phone verification (OTP)
# SMS_PROVIDER=log                # log (dev, prints OTP to stdout) | brevo
# BREVO_API_KEY=                  # required when SMS_PROVIDER=brevo
# BREVO_SMS_SENDER=CELINE         # alphanumeric sender id (max 11 chars) or E.164 number
# SMS_OTP_TEMPLATE=Il tuo codice di verifica e' {code}
# DPA_SMS_SIGNED=no               # must be yes for any non-log provider (GDPR Art. 28)
# OTP_CODE_LENGTH=6
# OTP_TTL_SECONDS=600             # code validity (10 min)
# OTP_MAX_ATTEMPTS=3              # wrong guesses before lockout
# OTP_MAX_SENDS_PER_HOUR=3        # per phone number
# OTP_LOCKOUT_SECONDS=3600        # lockout duration after attempts exhausted

# Dataspace DID/VC provisioning on admin approval (HTTP integration with identity-registry)
# DATASPACE_VC_ENABLED=false
# IDENTITY_REGISTRY_URL=http://host.docker.internal:30005   # required when DATASPACE_VC_ENABLED=true
# OIDC_BASE_URL=http://host.docker.internal:9080/realms/dataspaces  # M2M token issuer
# DS_ONBOARDING_CLIENT_ID=svc-ds-onboarding
# DS_ONBOARDING_CLIENT_SECRET=   # required when DATASPACE_VC_ENABLED=true
# DATASPACE_USER_ROLE=DataSubject
# DATASPACE_ALLOWED_ACTIONS=consent.manage,data.share
# DATASPACE_VC_TTL_DAYS=365
# DATASPACE_SUBJECT_SOURCE=email_hash  # deterministic from login email, without exposing email in DID paths

# ─────────────────────────────────────────────────────────────────────────────
# The per-community dataspace binding is NOT here — it lives in each template's
# manifest, under a `dataspace:` block:
#
#   dataspace:
#     organization: example-community          # = KC org alias = IR owner id
#     organization_did: did:web:example-community.dataspaces.localhost
#     linked_participant_did: did:web:consumer.dataspaces.localhost
#     membership_role: member
#
# It is per community because this platform is multi-tenant: a deployment serves
# several RECs and each belongs to its own dataspace organization. As deployment
# settings these filed every approved member into one organization — silently,
# since the wrong membership is still a successful 201.
#
# The organization must already exist and be promoted in the identity registry.
# Onboarding never creates one, and refuses to start when a bound community's
# organization is missing.
#
# DEPRECATED, read only when a manifest has no block, and warned on use:
# DATASPACE_ORGANIZATION_ALIAS=
# DATASPACE_ORGANIZATION_DID=
# DATASPACE_LINKED_PARTICIPANT_DID=
# DATASPACE_MEMBERSHIP_ROLE=member
# ─────────────────────────────────────────────────────────────────────────────

# Dedicated DS Keycloak user provisioning on admin approval
# DATASPACE_KEYCLOAK_ENABLED=false
# DATASPACE_KEYCLOAK_BASE_URL=http://host.docker.internal:8080
# DATASPACE_KEYCLOAK_REALM=dataspaces
# DATASPACE_KEYCLOAK_ADMIN_REALM=master
# DATASPACE_KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
# DATASPACE_KEYCLOAK_ADMIN_CLIENT_SECRET=
# DATASPACE_KEYCLOAK_ADMIN_USERNAME=admin
# DATASPACE_KEYCLOAK_ADMIN_PASSWORD=admin
# DATASPACE_KEYCLOAK_DEFAULT_PASSWORD=test
# DATASPACE_KEYCLOAK_TEMPORARY_PASSWORD=false
# DATASPACE_KEYCLOAK_UPDATE_EXISTING=true
