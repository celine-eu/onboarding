# Required
OPENAI_API_KEY=sk-...

# Database (external Postgres)
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=securepassword123
# DATABASE_URL=postgresql+asyncpg://postgres:securepassword123@localhost:15432/rec_onboarding

# Admin & security
# ADMIN_TOKEN=change-me-to-a-long-random-string
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional overrides
# EXTRACTION_BASE_URL=https://api.openai.com/v1
# EXTRACTION_MODEL=gpt-5.4
# DATA_DIR=./data
# TEMPLATE_DIR=./templates/example
# MAX_UPLOAD_SIZE_MB=10

# SMTP (email notifications on submission)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_TLS=true
# SMTP_NOTIFY=operator@example.com
